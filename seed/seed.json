				"data": {
					"title": "About",
					"content": [
						{
							"_type": "block",
							"_key": "k0",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "k1",
									"text": "Field Supply makes clothes for the roof and the street: a small run of heavy cotton, made to be worn hard."
								}
							]
						},
						{
							"_type": "block",
							"_key": "k2",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "k3",
									"text": "Each season is a handful of pieces — a coach jacket, hoodies, a tee and a sweatpant — made in small runs. When a piece is gone, it's gone."
								}
							]
						},
						{
							"_type": "block",
							"_key": "k4",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"_key": "k5",
									"text": "Where things live"
								}
							]
						},
						{
							"_type": "block",
							"_key": "k6",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "k7",
									"text": "Stock, sizes and checkout are Shopify's; the story is told here. The journal holds the lookbook and notes on how the clothes are made."
								}
							]
						}
					]
				}
			},
			{
				"id": "shipping-returns",
