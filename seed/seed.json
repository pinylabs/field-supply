				"data": {
					"title": "Shipping & returns",
					"content": [
						{
							"_type": "block",
							"_key": "k8",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"_key": "k9",
									"text": "Checkout on Shopify"
								}
							]
						},
						{
							"_type": "block",
							"_key": "ka",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "kb",
									"text": "Cards, wallets and receipts are Shopify's. Prices are in AUD, and shipping costs and times are shown at checkout before you pay."
								}
							]
						},
						{
							"_type": "block",
							"_key": "kc",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"_key": "kd",
									"text": "Free returns"
								}
							]
						},
						{
							"_type": "block",
							"_key": "ke",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "kf",
									"text": "Thirty days, any reason. Send a piece back unworn, with its tags, and you get your money back to the way you paid."
								}
							]
						},
						{
							"_type": "block",
							"_key": "kg",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"_key": "kh",
									"text": "Small runs"
								}
							]
						},
						{
							"_type": "block",
							"_key": "ki",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "kj",
									"text": "We make each piece in a small run. If your size has gone, it may not come back, so we can exchange it only while stock lasts."
								}
							]
						}
					]
				}
			}
