---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={`${term.label} posts`} description={`Posts in ${term.label}`}>
	<div class="page-head">
		<h1>{term.label}</h1>
		<p>Category</p>
	</div>

	{
		posts.length === 0 ? (
			<p class="py-10 text-body leading-body text-secondary-400">No posts in this category yet.</p>
		) : (
			<ul class="grid grid-cols-1 gap-x-4.5 gap-y-8.5 md:grid-cols-2 lg:grid-cols-3">
				{posts.map((post) => (
					<li class="story reveal grid content-start gap-3">
						<a href={`/posts/${post.id}`}>
							{post.data.featured_image && (
								<div class="frame aspect-4/3" {...post.edit.featured_image}><Image image={post.data.featured_image} /></div>
							)}
							<h2 class="mt-1 text-title leading-heading" {...post.edit.title}>{post.data.title}</h2>
						</a>
						{post.data.excerpt && <p class="text-small leading-body text-secondary-400" {...post.edit.excerpt}>{post.data.excerpt}</p>}
					</li>
				))}
			</ul>
		)
	}
	<nav class="pagination" aria-label="Pagination">
		{cursor && <a href={`/category/${term.slug}`}>First page</a>}
		{
			nextCursor && (
				<a
					class="next"
					href={`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}
				>
					Next page
				</a>
			)
		}
	</nav>
</Base>
