---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: products,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("products", {
	orderBy: { published_at: "desc" },
	limit: 24,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Shop">
	<h1>Shop</h1>
	<p>Stock, sizes and checkout are Shopify's; each product's story is told here.</p>

	{
		products.length === 0 ? (
			<p>No products yet.</p>
		) : (
			<ul>
				{products.map((product) => (
					<li>
						<a href={`/products/${product.id}`}>
							{product.data.image && (
								<div {...product.edit.image}><Image image={product.data.image} /></div>
							)}
							<h2 {...product.edit.title}>{product.data.title}</h2>
						</a>
						{product.data.price && <p {...product.edit.price}>{product.data.price}</p>}
						{product.data.note && <p {...product.edit.note}>{product.data.note}</p>}
					</li>
				))}
			</ul>
		)
	}
	<nav aria-label="Pagination">
		{cursor && <a href="/products">First page</a>}
		{
			nextCursor && (
				<a href={`/products?cursor=${encodeURIComponent(nextCursor)}`}>
					Next page
				</a>
			)
		}
	</nav>
</Base>
