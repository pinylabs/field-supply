---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across every post, instead of calling
// getEntryTerms() per post (which would be N round-trips).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title="All Posts">
	<div class="page-head">
		<h1>Journal</h1>
	</div>

	{
		postsWithTags.length === 0 ? (
			<p class="py-10 text-body leading-body text-secondary-400">No posts yet.</p>
		) : (
			<ul class="grid grid-cols-1 gap-x-4.5 gap-y-8.5 md:grid-cols-2 lg:grid-cols-3">
				{postsWithTags.map(({ post, tags }) => (
					<li class="story reveal grid content-start gap-3">
						<a href={`/posts/${post.id}`}>
							{post.data.featured_image && (
								<div class="frame aspect-4/3" {...post.edit.featured_image}><Image image={post.data.featured_image} /></div>
							)}
							<h2 class="mt-1 text-title leading-heading" {...post.edit.title}>{post.data.title}</h2>
						</a>
						{post.data.excerpt && <p class="text-small leading-body text-secondary-400" {...post.edit.excerpt}>{post.data.excerpt}</p>}
						{tags.length > 0 && (
							<div class="chips">
								{tags.map((t) => (
									<a class="chip" href={`/tag/${t.slug}`}>{t.label}</a>
								))}
							</div>
						)}
					</li>
				))}
			</ul>
		)
	}
	<nav class="pagination" aria-label="Pagination">
		{cursor && <a href="/posts">First page</a>}
		{
			nextCursor && (
				<a class="next" href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>
					Next page
				</a>
			)
		}
	</nav>
</Base>
