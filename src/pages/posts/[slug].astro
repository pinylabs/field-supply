---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="grid items-start gap-12 lg:grid-cols-article lg:gap-16">
		<article class="grid gap-5.5">
			{
				categories.length > 0 && (
					<div class="chips">
						{categories.map((c) => (
							<a class="chip chip-solid" href={`/category/${c.slug}`}>{c.label}</a>
						))}
					</div>
				)
			}

			<h1 class="text-display-story" {...post.edit.title}>{post.data.title}</h1>

			{
				post.data.publishedAt && (
					<div class="flex flex-wrap items-center gap-3.5 border-b pb-5">
						<time class="text-label tracking-label text-secondary-400 uppercase" datetime={post.data.publishedAt.toISOString()}>
							{post.data.publishedAt.toLocaleDateString("en-US", {
								year: "numeric",
								month: "long",
								day: "numeric",
							})}
						</time>
					</div>
				)
			}

			{
				post.data.featured_image && (
					<div class="frame aspect-video" {...post.edit.featured_image}>
						<Image image={post.data.featured_image} priority />
					</div>
				)
			}

			<div class="prose">
				<PortableText value={post.data.content} />
			</div>

			{
				tags.length > 0 && (
					<div class="chips border-t pt-5">
						{tags.map((t) => (
							<a class="chip" href={`/tag/${t.slug}`}>{t.label}</a>
						))}
					</div>
				)
			}
		</article>

		<aside class="grid gap-8.5 lg:sticky lg:top-7">
			<WidgetArea name="sidebar" class="grid gap-8.5" />
		</aside>
	</div>
</Base>
