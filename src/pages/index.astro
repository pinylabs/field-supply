---
// The preview home, from its accepted design. The full template is being built by the Pinies;
// until then this page is the theme's home and the rest of the site is EmDash's own template.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Field Supply — clothes for the roof and the street</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link is:inline rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style is:global>
/* The motion every site shares. Only transform and opacity move, so it stays on the compositor at 60 fps. Under
   prefers-reduced-motion everything is still, and a browser without scroll timelines simply shows the page. */

/* Page changes: the browser's cross-document view transition, as Astro's view transitions give it. A picture that
   names itself the same on both pages grows into its place; the rest fades and slides. */
@view-transition { navigation: auto; }
::view-transition-old(root) { animation: 260ms cubic-bezier(.4, 0, 1, 1) both vt-out; }
::view-transition-new(root) { animation: 420ms cubic-bezier(0, 0, .2, 1) 80ms both vt-in; }
::view-transition-group(*) { animation-duration: 520ms; animation-timing-function: cubic-bezier(.2, .8, .2, 1); }
@keyframes vt-out { to { opacity: 0; transform: translateY(-12px); } }
@keyframes vt-in { from { opacity: 0; transform: translateY(24px); } }

/* The hero's first moment: its words rise one line after another. */
.rise { animation: rise .9s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i, 0) * 110ms + 120ms); }
@keyframes rise { from { opacity: 0; transform: translateY(36px); } }

/* Scroll-driven: reveals move with `translate` and `scale`, so a card's hover `transform` still applies.
   The hero's photo drifts slower than the page, and its words lift away. */
@supports (animation-timeline: scroll()) {
  .parallax { animation: parallax linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
  .lift { animation: lift linear both; animation-timeline: scroll(root); animation-range: 0 70vh; }
  .reveal { animation: reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
  .reveal-side { animation: reveal-side linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; }
  .zoom-in { animation: zoom-in linear both; animation-timeline: view(); animation-range: entry 0% cover 50%; }
}
@keyframes parallax { from { transform: translateY(0) scale(1.08); } to { transform: translateY(22%) scale(1.16); } }
@keyframes lift { to { opacity: 0; transform: translateY(-90px); } }
@keyframes reveal { from { opacity: 0; translate: 0 70px; scale: .97; } }
@keyframes reveal-side { from { opacity: 0; translate: -60px 0; } }
@keyframes zoom-in { from { transform: scale(1.25); } }

/* Hover, for a site that takes it: a card lifts and its photo leans in. Each site adds its own signature beside it. */
.lift-card { transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s; }
.lift-card .pic img { transition: transform .9s cubic-bezier(.2, .8, .2, 1); }
.lift-card:hover { transform: translateY(-8px); }
.lift-card:hover .pic img { transform: scale(1.07); }
.button { transition: transform .25s cubic-bezier(.2, .8, .2, 1), background-color .25s; }
.button:hover { transform: translateY(-2px); }

/* Calm: opacity only, for a site whose signature is stillness. */
@supports (animation-timeline: view()) {
  .fade { animation: fade linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
}
@keyframes fade { from { opacity: 0; } }

/* The Pinies' entrances, the public site's four, played once when their row comes into view. */
.pinies[data-entrance] .face { animation-duration: .9s; animation-fill-mode: both; animation-delay: calc(var(--i) * .14s); animation-timing-function: cubic-bezier(.3, .7, .3, 1); }
.pinies[data-entrance='walk'] .face { animation-name: walk; }
.pinies[data-entrance='skid'] .face { animation-name: skid; }
.pinies[data-entrance='drop'] .face { animation-name: drop; animation-timing-function: ease-in; }
.pinies[data-entrance='peek'] .face { animation-name: peek; }
.pinies[data-entrance='peek'] .face:last-child { animation-name: peek, wave; animation-duration: .9s, .6s; animation-delay: calc(4 * .14s), 1.5s; animation-fill-mode: both, none; }
.pinies:not([data-entrance]):not([data-shown]) .face { opacity: 0; }
@keyframes walk {
  0% { transform: translateX(-120px); opacity: 0; } 12% { opacity: 1; }
  20% { transform: translateX(-96px) translateY(-4px); } 35% { transform: translateX(-70px) translateY(0); }
  50% { transform: translateX(-44px) translateY(-4px); } 65% { transform: translateX(-16px) translateY(0); }
  80% { transform: translateX(0) translateY(-16px); } 100% { transform: translateX(0) translateY(0); }
}
@keyframes skid {
  0% { transform: translateX(520px) rotate(0); opacity: 0; } 15% { opacity: 1; }
  65% { transform: translateX(-8px) rotate(-12deg); } 82% { transform: translateX(3px) rotate(3deg); } 100% { transform: translateX(0) rotate(0); }
}
@keyframes drop {
  0% { transform: translateY(-120px); opacity: 0; } 15% { opacity: 1; }
  60% { transform: translateY(0); } 75% { transform: translateY(-12px); } 90% { transform: translateY(0); } 95% { transform: translateY(-3px); } 100% { transform: translateY(0); }
}
@keyframes peek { 0% { transform: translateY(56px); opacity: 0; } 20% { opacity: 1; } 70% { transform: translateY(-5px); } 100% { transform: translateY(0); } }
@keyframes wave { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-12deg); } 50% { transform: rotate(10deg); } 75% { transform: rotate(-6deg); } }

/* Still: reduced motion, and the stills this mock renders. */
@media (prefers-reduced-motion: reduce) {
  @view-transition { navigation: none; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .pinies .face { opacity: 1 !important; }
}
html.still *, html.still *::before, html.still *::after { animation: none !important; transition: none !important; }
html.still .pinies .face { opacity: 1 !important; }
</style>
<style is:global>
/* Dark-led in both schemes: a night street, one acid accent, wide type. */
:root {
  --ground: #0b0b0c; --ink: #f2f0ea; --soft: #9a978f; --line: #24242a; --card: #141417; --acid: #d4ff3a; --acid-ink: #101400;
  --wide: 'Archivo', system-ui, sans-serif; --mono: 'IBM Plex Mono', ui-monospace, monospace;
}
@media (prefers-color-scheme: light) { :root { --ground: #161618; --card: #1d1d21; --line: #2e2e34; } }
* { box-sizing: border-box; margin: 0; }
html { background: var(--ground); }
body { background: var(--ground); color: var(--ink); font-family: var(--mono); -webkit-font-smoothing: antialiased; overflow-x: clip; }
a { color: inherit; text-decoration: none; }
.wrap { max-width: 1320px; margin: 0 auto; padding: 0 40px; }
header { border-bottom: 1px solid var(--line); }
header .wrap { display: flex; align-items: center; justify-content: space-between; height: 70px; }
.mark { font-family: var(--wide); font-weight: 800; font-stretch: 125%; font-size: 22px; letter-spacing: .02em; text-transform: uppercase; }
.mark b { color: var(--acid); }
nav { display: flex; gap: 26px; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; align-items: center; }
.cart { display: inline-flex; gap: 8px; align-items: center; border: 1px solid var(--line); padding: 8px 14px; border-radius: 999px; }
.cart i { font-style: normal; background: var(--acid); color: var(--acid-ink); border-radius: 999px; min-width: 22px; height: 22px; display: inline-grid; place-items: center; font-weight: 600; }
/* The signature: a headline wider than the screen over a marquee of the season that never stops, pausing under the pointer. */
.hero { position: relative; padding: 40px 0 0; overflow: hidden; }
.hero h1 { font-family: var(--wide); font-weight: 800; font-stretch: 125%; font-size: 150px; line-height: .82; letter-spacing: -.02em; text-transform: uppercase; white-space: nowrap; padding: 0 max(40px, calc((100vw - 1240px) / 2)); position: relative; z-index: 2; mix-blend-mode: difference; color: #fff; }
.hero h1 span { display: block; }
.hero h1 .slide { animation: slide-in 1.1s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * 140ms); }
@keyframes slide-in { from { transform: translateX(-40%); opacity: 0; } }
.marquee { margin-top: 28px; display: flex; gap: 14px; width: max-content; animation: run 38s linear infinite; }
.hero:hover .marquee { animation-play-state: paused; }
@keyframes run { to { transform: translateX(calc(-50% - 7px)); } }
.marquee figure { width: 300px; aspect-ratio: 3 / 4; border-radius: 4px; overflow: hidden; flex: none; position: relative; }
.marquee figure img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(1.05) contrast(1.05); }
.marquee figcaption { position: absolute; left: 10px; bottom: 10px; background: var(--acid); color: var(--acid-ink); font-size: 12px; padding: 4px 8px; text-transform: uppercase; }
.hero .intro { display: flex; justify-content: space-between; align-items: end; gap: 40px; padding: 34px max(40px, calc((100vw - 1240px) / 2)) 56px; }
.hero .intro p { font-size: 15px; line-height: 1.6; color: var(--soft); max-width: 460px; }
.hero .intro a { background: var(--acid); color: var(--acid-ink); padding: 16px 24px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; font-size: 14px; }
.shop { border-top: 1px solid var(--line); padding: 56px 0 72px; }
.shop .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 26px; }
.shop h2 { font-family: var(--wide); font-weight: 800; font-stretch: 125%; font-size: 44px; text-transform: uppercase; letter-spacing: -.01em; }
.shop .head span { color: var(--soft); font-size: 13px; text-transform: uppercase; letter-spacing: .08em; }
.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.item { position: relative; }
.item .pic { position: relative; aspect-ratio: 3 / 4; background: var(--card); overflow: hidden; border-radius: 4px; }
.item .pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .5s ease, transform .9s cubic-bezier(.2, .8, .2, 1); }
.item .pic img + img { opacity: 0; }
.item:hover .pic img + img { opacity: 1; transform: scale(1.03); }
.item .add { position: absolute; left: 10px; right: 10px; bottom: 10px; background: var(--ink); color: var(--ground); text-align: center; padding: 12px; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; font-weight: 600; transform: translateY(140%); transition: transform .35s cubic-bezier(.2, .8, .2, 1); }
.item:hover .add { transform: none; }
.item h3 { font-family: var(--wide); font-weight: 700; font-stretch: 112%; font-size: 17px; text-transform: uppercase; margin-top: 12px; }
.item .price { display: flex; justify-content: space-between; color: var(--soft); font-size: 13px; margin-top: 4px; }
.item .price b { color: var(--ink); font-weight: 500; }
.trust { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.trust .wrap { display: grid; grid-template-columns: repeat(3, 1fr); }
.trust div { padding: 26px 0; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--soft); }
.trust b { display: block; color: var(--ink); font-family: var(--wide); font-stretch: 112%; font-size: 18px; letter-spacing: 0; margin-bottom: 4px; }
footer { padding: 40px 0 48px; }
footer .wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: end; }
footer .made { display: flex; align-items: flex-end; gap: 18px; }
.pinies { display: flex; }
.pinies .face { width: 54px; height: 54px; margin-right: -8px; }
.pinies .face svg { width: 100%; height: 100%; }
footer .made p { font-size: 13px; line-height: 1.6; color: var(--soft); }
footer .made a { color: var(--ink); text-decoration: underline; }
footer .credits { font-size: 11px; line-height: 1.8; color: var(--soft); }
footer .credits a { text-decoration: underline; text-decoration-color: var(--line); }
@media (prefers-reduced-motion: reduce) { .marquee { animation: none; } }
html.still .marquee { animation: none; }
@media (max-width: 767px) {
  .wrap { padding: 0 18px; }
  nav a:not(.cart) { display: none; }
  .mark { font-size: 17px; }
  .hero h1 { font-size: 62px; padding: 0 18px; white-space: normal; }
  .marquee { margin-top: 14px; }
  .marquee figure { width: 190px; }
  .hero .intro { flex-direction: column; align-items: start; padding: 26px 18px 40px; }
  .shop h2 { font-size: 30px; }
  .grid { grid-template-columns: 1fr 1fr; gap: 12px; }
  .item .add { transform: none; padding: 9px; font-size: 11px; }
  .trust .wrap { grid-template-columns: 1fr; }
  .trust div { padding: 16px 0; }
  footer .wrap { grid-template-columns: 1fr; }
  footer .made { flex-direction: column; align-items: flex-start; }
}
.still-card { height: 100%; display: grid; place-items: center; background: linear-gradient(135deg, var(--sky1, #bfe8ef), var(--sky2, #ffe2b8)); font-family: var(--display); font-weight: 700; font-size: 34px; color: var(--ink); }
</style>
</head>
