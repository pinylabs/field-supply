---
// The preview home, from its accepted design. The full template is being built by the Pinies;
// until then this page is the theme's home and the rest of the site is EmDash's own template.
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Field Supply — clothes for the roof and the street</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
</head>
<body>
<header class="border-b"><div class="wrap flex flex-wrap items-center justify-between md:h-header md:flex-nowrap">
  <a class="mark" href="/">Field<b class="text-primary-300">/</b>Supply</a>
  <div class="flex items-center gap-6.5 text-label tracking-label uppercase max-md:contents">
    <nav class="nav-row" aria-label="Primary"><a href="/products">Shop</a><a href="/products">New</a><a href="/posts">Journal</a></nav>
    <a class="cart" href="#">Cart <i>2</i></a>
  </div>
</div></header>
<section class="hero relative overflow-hidden pt-10">
  <h1 class="relative z-2 px-hero text-hero whitespace-nowrap text-white mix-blend-difference max-md:px-gutter-phone max-md:text-hero-phone max-md:whitespace-normal"><span class="slide" style="--i:0">Made for</span><span class="slide" style="--i:1">the roof.</span></h1>
  <div class="marquee" aria-hidden="true">
    <figure><img src="https://images.unsplash.com/photo-1578854955076-970394ef2512?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Coach jacket</figcaption></figure>
    <figure><img src="https://images.unsplash.com/photo-1588117260148-b47818741c74?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Loop sweatpant</figcaption></figure>
    <figure><img src="https://images.unsplash.com/photo-1620799140188-3b2a02fd9a77?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Heavy hoodie</figcaption></figure>
    <figure><img src="https://images.unsplash.com/photo-1564557287817-3785e38ec1f5?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Sand hoodie</figcaption></figure>
    <figure><img src="https://images.unsplash.com/photo-1757495404191-e94ed7e70046?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Night hoodie</figcaption></figure>
    <figure><img src="https://images.unsplash.com/photo-1578854955076-970394ef2512?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Coach jacket</figcaption></figure>
    <figure><img src="https://images.unsplash.com/photo-1588117260148-b47818741c74?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Loop sweatpant</figcaption></figure>
    <figure><img src="https://images.unsplash.com/photo-1620799140188-3b2a02fd9a77?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Heavy hoodie</figcaption></figure>
    <figure><img src="https://images.unsplash.com/photo-1564557287817-3785e38ec1f5?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Sand hoodie</figcaption></figure>
    <figure><img src="https://images.unsplash.com/photo-1757495404191-e94ed7e70046?w=900&q=75&auto=format&fit=crop" alt=""><figcaption>Night hoodie</figcaption></figure>
  </div>
  <div class="flex items-end justify-between gap-10 px-hero pt-8.5 pb-14 max-md:flex-col max-md:items-start max-md:px-gutter-phone max-md:pt-6.5 max-md:pb-10"><p class="max-w-copy text-body leading-body text-secondary-400">A small run of heavy cotton, made to be worn hard. Stock, sizes and checkout are Shopify's; the story is told here.</p><a class="button" href="/products">Shop the season</a></div>
</section>
<main>
  <section class="border-t pt-14 pb-18"><div class="wrap">
    <div class="mb-6.5 flex items-baseline justify-between"><h2 class="reveal font-display text-section font-extrabold max-md:text-heading">The season</h2><span class="text-label tracking-label text-secondary-400 uppercase">Prices in AUD · from Shopify</span></div>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4.5">
      <a class="card reveal" href="/products/night-hoodie"><div class="frame aspect-3/4"><img style="view-transition-name: product-night" src="https://images.unsplash.com/photo-1757495404191-e94ed7e70046?w=900&q=75&auto=format&fit=crop" alt="Night hoodie, worn" loading="lazy"><img src="https://images.unsplash.com/photo-1564557287817-3785e38ec1f5?w=900&q=75&auto=format&fit=crop" alt="" loading="lazy" class="card-alt"><span class="card-add">Add to cart</span></div><h3 class="mt-3 text-card">Night hoodie</h3><div class="mt-1 flex justify-between text-label text-secondary-400"><span>3 colours</span><b class="font-medium text-secondary-50">$120</b></div></a>
      <a class="card reveal" href="/products/heavy-hoodie"><div class="frame aspect-3/4"><img src="https://images.unsplash.com/photo-1620799140188-3b2a02fd9a77?w=900&q=75&auto=format&fit=crop" alt="Heavy hoodie, laid flat" loading="lazy"><img src="https://images.unsplash.com/photo-1578854955076-970394ef2512?w=900&q=75&auto=format&fit=crop" alt="" loading="lazy" class="card-alt"><span class="card-add">Add to cart</span></div><h3 class="mt-3 text-card">Heavy hoodie</h3><div class="mt-1 flex justify-between text-label text-secondary-400"><span>2 colours</span><b class="font-medium text-secondary-50">$130</b></div></a>
      <a class="card reveal" href="/products/ordinary-tee"><div class="frame aspect-3/4"><img src="https://images.unsplash.com/photo-1636047250452-6772f6144b3d?w=900&q=75&auto=format&fit=crop" alt="Graphic tee, worn" loading="lazy"><img src="https://images.unsplash.com/photo-1588117260148-b47818741c74?w=900&q=75&auto=format&fit=crop" alt="" loading="lazy" class="card-alt"><span class="card-add">Add to cart</span></div><h3 class="mt-3 text-card">Ordinary tee</h3><div class="mt-1 flex justify-between text-label text-secondary-400"><span>Back print</span><b class="font-medium text-secondary-50">$55</b></div></a>
      <a class="card reveal" href="/products/loop-sweatpant"><div class="frame aspect-3/4"><img src="https://images.unsplash.com/photo-1588117260148-b47818741c74?w=900&q=75&auto=format&fit=crop" alt="Loop sweatpant, worn on a rooftop" loading="lazy"><img src="https://images.unsplash.com/photo-1636047250452-6772f6144b3d?w=900&q=75&auto=format&fit=crop" alt="" loading="lazy" class="card-alt"><span class="card-add">Add to cart</span></div><h3 class="mt-3 text-card">Loop sweatpant</h3><div class="mt-1 flex justify-between text-label text-secondary-400"><span>Grey marl</span><b class="font-medium text-secondary-50">$95</b></div></a>
    </div>
  </div></section>
  <section class="border-y"><div class="mx-auto grid max-w-page py-6.5 text-label tracking-label text-secondary-400 uppercase max-md:py-4 md:grid-cols-3"><div class="py-6.5 max-md:py-4"><b class="mb-1 block font-sans text-feature tracking-normal text-secondary-50">Checkout on Shopify</b>Cards, wallets and receipts are Shopify's</div><div class="py-6.5 max-md:py-4"><b class="mb-1 block font-sans text-feature tracking-normal text-secondary-50">Free returns</b>Thirty days, any reason</div><div class="py-6.5 max-md:py-4"><b class="mb-1 block font-sans text-feature tracking-normal text-secondary-50">Made in small runs</b>When it's gone, it's gone</div></div></section>
</main>
