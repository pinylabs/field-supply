---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/global.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

// The home's mark: the site's words in wide capitals, an acid slash between them ("Field/Supply").
const markWords = siteTitle.split(/\s+/).filter(Boolean);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (url: string) =>
	url !== "/" && (path === url || path.startsWith(`${url}/`));

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en" class="scheme-dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />
		<EmDashHead page={pageCtx} />
	</head>
	<body class="flex min-h-screen flex-col">
		<EmDashBodyStart page={pageCtx} />

		<header class="border-b">
			<div class="wrap flex flex-wrap items-center justify-between gap-x-6 md:h-header md:flex-nowrap">
				<a class="mark" href="/">{
					siteLogo ? (
						<img class="h-10 w-auto" src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
					) : (
						markWords.map((word, i) => <>{i > 0 && <b class="text-primary-300">/</b>}{word}</>)
					)
				}</a>
				<div class="flex items-center gap-6.5 text-label tracking-label uppercase max-md:contents">
					<nav class="nav-row" aria-label="Primary">
						{
							menu?.items.map((item) => (
								<a
									href={item.url}
									target={item.target}
									rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
									aria-current={isCurrent(item.url) ? "page" : undefined}
								>
									{item.label}
								</a>
							))
						}
					</nav>
					<LiveSearch class="site-search w-search tracking-normal normal-case max-md:hidden!" placeholder="Search..." collections={["posts", "pages"]} />
					<a class="cart" href="#">Cart <i>2</i></a>
				</div>
			</div>
		</header>

		<main class="flex-1 pt-14 pb-18 max-md:pt-8.5 max-md:pb-14">
			<div class="wrap">
				<slot />
			</div>
		</main>

		<footer class="border-t pt-10 pb-12"><div class="wrap grid grid-cols-footer items-end gap-10 max-md:grid-cols-1">
